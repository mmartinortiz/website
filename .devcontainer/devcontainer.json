{
  "name": "Hugo Website",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "appPort": ["0.0.0.0:1313:1313"],
  "features": {
    "ghcr.io/devcontainers-extra/features/pre-commit:2": {
      "version": "latest"
    },
    "ghcr.io/devcontainers-extra/features/starship:1": {
      "version": "latest"
    },
    "ghcr.io/meaningful-ooo/devcontainer-features/fish:2": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/hugo:1": {
      "version": "0.151.2",
      "extended": true
    }
  },
  "containerEnv": {
    "HUGO_ENVIRONMENT": "development"
  },
  "initializeCommand": {
    "create permanent fish history": "mkdir -p ~/.devcontainer/${devcontainerId} && touch ~/.devcontainer/${devcontainerId}/fish_history"
  },
  "onCreateCommand": {
    "pre-commit": "pre-commit install --install-hooks",
    "setup configs": ".devcontainer/setup-configs.sh"
  },
  "postCreateCommand": {
    "git submodules": "git submodule update --init --recursive"
  },
  "updateContentCommand": {
    "pre-commit autoupdate": "pre-commit autoupdate"
  },
  "forwardPorts": [1313],
  "portsAttributes": {
    "1313": {
      "label": "Hugo Server",
      "onAutoForward": "openBrowser"
    }
  },
  "mounts": [
    {
      "source": "${localEnv:HOME}/.devcontainer/${devcontainerId}/fish_history",
      "target": "/home/vscode/.local/share/fish/fish_history",
      "type": "bind"
    }
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "tamasfe.even-better-toml",
        "yzhang.markdown-all-in-one",
        "streetsidesoftware.code-spell-checker",
        "budparr.language-hugo-vscode",
        "akmittal.hugofy"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "fish"
      }
    }
  }
}
